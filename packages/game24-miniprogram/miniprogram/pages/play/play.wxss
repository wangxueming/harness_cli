.play {
  padding: 24rpx;
}

.timer {
  text-align: center;
  font-size: 32rpx;
  margin-bottom: 16rpx;
}

.explore-progress {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.board {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  margin: 40rpx 0;
}

.card {
  width: 140rpx;
  height: 180rpx;
  background: #fff;
  border: 2rpx solid #333;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.card.selected {
  border-color: #e94560;
  background: #ffeaea;
}

.card.consumed {
  opacity: 0.4;
}

.card.flipping {
  transition: transform 0.3s;
  transform: rotateY(180deg);
}

.operators {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.history {
  margin-top: 24rpx;
}

.history-item {
  padding: 8rpx 0;
  color: #666;
}

.history-item.active {
  color: #e94560;
  font-weight: bold;
}

.hint-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #1a1a2e;
  color: #fff;
}

.feedback {
  text-align: center;
  color: #e94560;
  margin-top: 16rpx;
}
